# Copy this file to .env for local runs (never commit the real .env).
# On Render, set these as dashboard Environment Variables instead of a file.

# --- TiDB connection ---
# TiDB Cloud Serverless: Cluster -> Connect -> Node.js. Host looks like
# gateway01.<region>.prod.aws.tidbcloud.com, user looks like
# <prefix>.root, database is whatever you created (e.g. ndr_portal).
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=ndr_portal
# Set to "false" only for a local/self-hosted TiDB without TLS. Leave
# "true" (the default) for TiDB Cloud.
TIDB_SSL=true
# Only needed for a self-hosted cluster with a private CA. TiDB Cloud's
# certificate is publicly trusted so this can stay empty there.
TIDB_CA_PATH=

# --- API server ---
PORT=4001

# --- Used only by `npm run setup` (one-time schema + admin bootstrap) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
# Optional second account with the 'hr' role (create-only: Students/Job
# Status, no edit/delete, no Payments). Leave both blank to skip.
HR_USERNAME=
HR_PASSWORD=
